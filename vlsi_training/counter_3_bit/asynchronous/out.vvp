#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x57c0b52a02a0 .scope module, "testbench" "testbench" 2 1;
 .timescale 0 0;
v0x57c0b52b1f80_0 .var "clk", 0 0;
v0x57c0b52b2050_0 .net "count", 2 0, v0x57c0b52b1d80_0;  1 drivers
v0x57c0b52b2120_0 .var "reset", 0 0;
S_0x57c0b52a0430 .scope module, "uut" "counter_3_bit" 2 5, 3 1 0, S_0x57c0b52a02a0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 3 "count";
v0x57c0b528de40_0 .net "clk", 0 0, v0x57c0b52b1f80_0;  1 drivers
v0x57c0b52b1d80_0 .var "count", 2 0;
v0x57c0b52b1e60_0 .net "reset", 0 0, v0x57c0b52b2120_0;  1 drivers
E_0x57c0b52a0c80 .event posedge, v0x57c0b52b1e60_0, v0x57c0b528de40_0;
    .scope S_0x57c0b52a0430;
T_0 ;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x57c0b52b1d80_0, 0, 3;
    %end;
    .thread T_0;
    .scope S_0x57c0b52a0430;
T_1 ;
    %wait E_0x57c0b52a0c80;
    %load/vec4 v0x57c0b52b1e60_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x57c0b52b1d80_0, 0, 3;
    %jmp T_1.1;
T_1.0 ;
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x57c0b52b1d80_0;
    %pushi/vec4 1, 0, 3;
    %add;
    %store/vec4 v0x57c0b52b1d80_0, 0, 3;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x57c0b52a02a0;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x57c0b52b1f80_0;
    %inv;
    %store/vec4 v0x57c0b52b1f80_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x57c0b52a02a0;
T_3 ;
    %vpi_call 2 14 "$monitor", "clk = %b | reset = %b | count = %b or %d", v0x57c0b52b1f80_0, v0x57c0b52b2120_0, v0x57c0b52b2050_0, v0x57c0b52b2050_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57c0b52b1f80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57c0b52b2120_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57c0b52b2120_0, 0, 1;
    %delay 180, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57c0b52b2120_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57c0b52b2120_0, 0, 1;
    %delay 20, 0;
    %vpi_call 2 33 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "design.v";
